# Copia este archivo como .env y ajusta los valores. Ninguno es obligatorio en local.

# Puerto y dirección de escucha (HOST=0.0.0.0 para probar desde el celular en tu red).
PORT=3000
# HOST=127.0.0.1

# En producción: activa cookies seguras (HTTPS) y encabezado HSTS.
# NODE_ENV=production

# Detrás de un proxy inverso (Nginx, Render, Railway…): 1
# TRUST_PROXY=1

# Dominio público, sin "/" final. Activa la URL canónica y sitemap.xml.
# SITE_URL=https://www.tudominio.com

# Carpeta de datos persistentes (catálogo, imágenes, respaldos). Por defecto ./data
# DATA_DIR=/var/data/nexomed

# Secreto para firmar sesiones (mínimo 32 caracteres). Si no se define, se genera
# automáticamente en data/.session-secret.
# SESSION_SECRET=

# Alternativa a data/admin.json para hostings sin acceso a terminal.
# Genera los valores con: npm run admin:crear -- --imprimir
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=

# Duración de la sesión del panel, en horas.
# SESSION_HOURS=8
